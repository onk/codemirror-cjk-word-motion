  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
